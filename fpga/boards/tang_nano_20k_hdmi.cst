IO_PORT "a_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "a_d[5]" 86;
IO_PORT "a_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
