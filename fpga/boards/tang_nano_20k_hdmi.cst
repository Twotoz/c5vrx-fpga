// Triversity HDMI build, Sipeed Tang Nano 20K (QN88): the LCD pins carry the TMDS pairs (Sipeed hdmi.cst).

IO_LOC "xtal" 4;
IO_PORT "xtal" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "key_s1" 88;
IO_PORT "key_s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "key_s2" 87;
IO_PORT "key_s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "a_clk" 76;
IO_PORT "a_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "b_clk" 72;
IO_PORT "b_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "c_clk" 73;
IO_PORT "c_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "link_tx" 51;
IO_PORT "link_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "a_d[1]" 80;
IO_PORT "a_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "a_d[2]" 56;
IO_PORT "a_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
