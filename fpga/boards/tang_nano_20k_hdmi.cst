IO_PORT "a_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "b_d[1]" 71;
IO_PORT "b_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "b_d[2]" 53;
IO_PORT "b_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "b_d[3]" 52;
IO_PORT "b_d[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "b_d[4]" 18;
IO_PORT "b_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "b_d[5]" 19;
IO_PORT "b_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "b_d[6]" 20;
IO_PORT "b_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "c_d[1]" 74;
IO_PORT "c_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "c_d[2]" 75;
IO_PORT "c_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "c_d[3]" 85;
IO_PORT "c_d[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "c_d[4]" 15;
IO_PORT "c_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "c_d[5]" 16;
IO_PORT "c_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "c_d[6]" 17;
IO_PORT "c_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// TF card slot, SPI mode (DVR): CLK 83, CMD 82 (MOSI), D0 84 (MISO), D3 81 (CS); D1/D2 are C5 data pins
IO_LOC "sd_sck" 83;
IO_PORT "sd_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "sd_mosi" 82;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "sd_miso" 84;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "sd_cs" 81;
IO_PORT "sd_cs" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;
IO_LOC "tmds_d0_p" 35,36;
IO_PORT "tmds_d0_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;
IO_LOC "tmds_d1_p" 37,38;
IO_PORT "tmds_d1_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;
IO_LOC "tmds_d2_p" 39,40;
IO_PORT "tmds_d2_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;
